# EGTRAIN code style.
#
#   - Tab indentation, braces attached, C++17, Qt 5 widgets code.
#   - ColumnLimit 0: the formatter keeps the line breaks of the author and does
#     not wrap to a width.
#   - A continuation line gets one extra indent. Nothing is aligned after an
#     opening bracket.
#   - Binary operators lead the continuation line (&&, ||, +, ==).
#   - Short statements, blocks and functions stay on one line when they are
#     written that way.
#   - Whitespace and line breaks only: no option here rewrites tokens.
#
# Written for clang-format 23.1.3. Older releases do not know every key.
#
# Vendored code under EGTRAIN/QEGTRAIN/io/third_party/ is excluded through
# .clang-format-ignore.

BasedOnStyle: LLVM
Language: Cpp
Standard: c++17

# Indentation
UseTab: Always
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
ConstructorInitializerIndentWidth: 4
AccessModifierOffset: -4
IndentCaseLabels: true
NamespaceIndentation: None

# Line breaking
ColumnLimit: 0
BreakBeforeBraces: Attach
BreakBeforeBinaryOperators: NonAssignment
AlignAfterOpenBracket: false
AlignOperands: DontAlign
BreakTemplateDeclarations: Leave

# Short constructs may stay on one line. With ColumnLimit 0 the formatter does
# not put a wrapped one on one line.
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortLoopsOnASingleLine: true
AllowShortFunctionsOnASingleLine: All
AllowShortCaseLabelsOnASingleLine: true
AllowShortBlocksOnASingleLine: Always
AllowShortNamespacesOnASingleLine: true
AllowShortRecordOnASingleLine: Always

# Alignment and spacing
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignTrailingComments: true
PointerAlignment: Left
ReferenceAlignment: Left
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
Cpp11BracedListStyle: true

# Blank lines
MaxEmptyLinesToKeep: 2
EmptyLineBeforeAccessModifier: Leave
InsertNewlineAtEOF: true

# The code depends on include order in places: never sort or regroup.
SortIncludes: Never
IncludeBlocks: Preserve

# Never rewrite tokens (no brace insertion, no semicolon or parenthesis
# removal, no qualifier reordering, no comment fixing, no digit separators).
SortUsingDeclarations: Never
FixNamespaceComments: false
InsertBraces: false
RemoveSemicolon: false
RemoveParentheses: Leave
QualifierAlignment: Leave
