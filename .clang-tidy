# clang-tidy configuration for EGTRAIN.
#
# The selection favours checks that find real bugs (bugprone-*,
# clang-analyzer-*, performance-*) over checks that would demand a style
# rewrite of the legacy simulation code (most of modernize-* and
# cppcoreguidelines-*).
#
# Configure once so that build/compile_commands.json exists, then run for example:
#   clang-tidy -p build EGTRAIN/QEGTRAIN/scene/SceneModel.cpp
#
# Vendored code under EGTRAIN/QEGTRAIN/io/third_party/ has its own .clang-tidy
# that switches the analysis off, and the header filter below does not match it.
#
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  clang-analyzer-*,
  performance-*,
  -performance-no-int-to-ptr,
  readability-misleading-indentation,
  readability-redundant-control-flow,
  readability-redundant-declaration,
  readability-duplicate-include,
  misc-redundant-expression,
  misc-unused-parameters,

WarningsAsErrors: ''

HeaderFilterRegex: 'EGTRAIN/QEGTRAIN/(app|diagrams|graphics|graphics/items|io|scene|simulation|telemetry|update|util|widgets)/[^/]+\.(h|hpp)$'

FormatStyle: file

CheckOptions:
  - key: bugprone-argument-comment.StrictMode
    value: 'false'
