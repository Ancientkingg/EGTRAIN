QMainWindow, QWidget {
    background: #eef2f5;
    color: #24313a;
}

QToolBar {
    background: #f8fafb;
    border: 0;
    border-bottom: 1px solid #c9d3db;
    spacing: 4px;
    padding: 1px 8px;
    min-height: 44px;
}

QToolBar::separator {
    background: #c9d3db;
    width: 1px;
    margin: 5px 7px;
}

QLabel#speedSlowerLabel, QLabel#speedFasterLabel {
    color: #5b6871;
    font-size: 11px;
    padding: 0;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    color: #24313a;
    padding: 3px 6px;
    min-height: 24px;
    max-height: 32px;
}

QToolButton#actionZoomInButton, QToolButton#actionZoomOutButton {
    padding: 3px;
}

QToolBar QLabel, QToolBar QSlider {
    background: transparent;
}

QToolButton:hover, QToolButton:focus {
    background: #e4eaee;
    border-color: #315a70;
}

QToolButton#openCaseButton {
    background: #e7edf1;
    border-color: #c5d0d7;
    font-weight: 600;
    padding-left: 9px;
    padding-right: 9px;
}

QToolButton#openCaseButton:hover, QToolButton#openCaseButton:focus {
    background: #dce6eb;
    border-color: #315a70;
}

QToolButton:disabled {
    color: #64717a;
}

QToolButton:checked {
    background: #315a70;
    color: #ffffff;
}

QDockWidget {
    background: #f8fafb;
    color: #24313a;
}

QDockWidget::title {
    background: #e3eaee;
    border-bottom: 1px solid #c9d3db;
    font-weight: 600;
    padding: 6px 8px;
    text-align: left;
}

QLabel#caseNameLabel {
    color: #315a70;
    font-size: 14px;
    font-weight: 600;
    padding: 3px 0 1px;
}

QLabel#caseReadinessLabel {
    color: #5b6871;
    font-size: 11px;
    padding: 0 0 8px;
}

QLabel#caseReadinessLabel[blocking="true"] {
    color: #965c22;
}

QLabel#caseStudyTitleLabel, QLabel#layersTitleLabel {
    color: #5b6871;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
    text-transform: uppercase;
}

QCheckBox {
    spacing: 7px;
    padding: 5px 2px;
}

QListView::indicator, QTableView::indicator, QTreeView::indicator {
    width: 14px;
    height: 14px;
    background: #ffffff;
    border: 1px solid #5b6871;
    border-radius: 2px;
}

QListView::indicator:checked, QTableView::indicator:checked, QTreeView::indicator:checked {
    background: #315a70;
    border-color: #315a70;
    image: url(:/icons/check-mark.svg);
}

QListView::indicator:disabled, QTableView::indicator:disabled, QTreeView::indicator:disabled {
    background: #e4e8eb;
    border-color: #c9d3db;
}

QListView::indicator:checked:disabled, QTableView::indicator:checked:disabled,
QTreeView::indicator:checked:disabled {
    background: #9aa5ab;
    border-color: #9aa5ab;
}

QCheckBox[secondaryLayerToggle="true"] {
    color: #5b6871;
    margin-left: 16px;
}

QCheckBox:disabled {
    color: #64717a;
}

QCheckBox:focus {
    background: #e6ecee;
    border: 1px solid #315a70;
    border-radius: 2px;
}

QPushButton:focus, QComboBox:focus, QSlider:focus, QLineEdit:focus {
    outline: 1px solid #315a70;
    outline-offset: 1px;
}

QToolButton#mapKeyToggle {
    color: #5b6871;
    font-size: 11px;
    font-weight: 600;
    padding: 5px 2px;
    text-align: left;
}

QToolButton#mapKeyToggle:checked {
    background: transparent;
    border-color: transparent;
    color: #5b6871;
}

QToolButton#mapKeyToggle:hover, QToolButton#mapKeyToggle:focus {
    background: #e6ecee;
    border-color: #315a70;
}

QWidget#mapKeyBody QLabel {
    color: #3f4d56;
    font-size: 11px;
}

QPushButton:focus, QComboBox:focus, QLineEdit:focus {
    border-color: #315a70;
}

QPushButton, QComboBox, QLineEdit {
    background: #ffffff;
    border: 1px solid #c8ced2;
    border-radius: 2px;
    padding: 5px 7px;
}

QPushButton:hover, QComboBox:hover {
    border-color: #315a70;
}

QPushButton:pressed {
    background: #d8e1e5;
}

QDialog#runReviewDialog, QDialog[dialogPresentation="true"] {
    background: #f8fafb;
}

QLabel#dialogHeading {
    background: transparent;
    color: #24313a;
    font-weight: 600;
}

QLabel#dialogContext, QLabel#diagramContext, QLabel#timetableContext,
QLabel#runReviewFactLabel, QLabel[dialogHelp="true"] {
    background: transparent;
    color: #5b6871;
}

QLabel#runReviewFactValue {
    background: transparent;
    font-weight: 600;
}

QLabel[dialogStatus="neutral"], QLabel#runReviewStatus {
    background: #e7edf1;
    border: 1px solid #c5d0d7;
    border-radius: 2px;
    color: #3f4d56;
    padding: 9px;
}

QLabel[dialogStatus="warning"], QLabel#runReviewStatus[warning="true"] {
    background: #f5eadc;
    border: 1px solid #d8b98e;
    color: #74451c;
}

QLabel[dialogStatus="error"] {
    background: #f7e8e6;
    border: 1px solid #c98f88;
    border-radius: 2px;
    color: #81352d;
    padding: 9px;
}

QDialog#aboutDialog QPushButton[aboutLink="true"] {
    color: #315a70;
    text-decoration: underline;
    text-align: left;
    padding: 2px 4px;
}

QDialog#aboutDialog QPushButton[aboutLink="true"]:focus {
    border: 2px solid #315a70;
}

QDialog#caseChooserDialog QListWidget::item:disabled {
    color: #5b6871;
    background: transparent;
}

QLabel#runReviewDetails {
    background: #eef2f5;
    border: 1px solid #c9d3db;
    padding: 8px;
}

QDialog[dialogPresentation="true"] QDialogButtonBox QPushButton:default, QPushButton#runReviewRunButton {
    background: #315a70;
    border-color: #315a70;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#runReviewRunButton {
    min-width: 110px;
}

QDialog[dialogPresentation="true"] QDialogButtonBox QPushButton:default:hover, QPushButton#runReviewRunButton:hover {
    background: #26495c;
    border-color: #26495c;
}

QDialog[dialogPresentation="true"] QDialogButtonBox QPushButton:default:focus, QPushButton#runReviewRunButton:focus {
    border-color: #315a70;
    outline: 2px solid #315a70;
}

QPushButton:disabled,
QComboBox:disabled,
QLineEdit:disabled {
    background: #e4e8eb;
    border-color: #c9d3db;
    color: #64717a;
}

QDialog[dialogPresentation="true"] QDialogButtonBox QPushButton:default:disabled, QPushButton#runReviewRunButton:disabled {
    background: #dce3e7;
    border-color: #c9d3db;
    color: #64717a;
}

QTabWidget::pane {
    border: 1px solid #c9d3db;
    background: #f8fafb;
}

QTabBar::tab {
    background: #e3eaee;
    border: 1px solid #c9d3db;
    padding: 5px 10px;
}

QTabBar::tab:selected {
    background: #315a70;
    color: #ffffff;
}

QLineEdit[readOnly="true"] {
    background: #eceeec;
    color: #5b6871;
    border-color: #c8ced2;
}

QDialog[dialogPresentation="true"] QLineEdit[readOnly="true"]:focus {
    border-color: #315a70;
    outline: 1px solid #315a70;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #c8ced2;
}

QSlider::handle:horizontal {
    width: 12px;
    margin: -5px 0;
    border: 2px solid #315a70;
    border-radius: 7px;
    background: #ffffff;
}

QProgressBar {
    border: 1px solid #c8ced2;
    border-radius: 2px;
    background: #eceeec;
    color: #24313a;
    text-align: right;
}

QProgressBar::chunk {
    background: #315a70;
}

QPlainTextEdit {
    background: #12191f;
    color: #dde3e5;
}

QPlainTextEdit#signallingGroupDetails {
    background: #ffffff;
    color: #24313a;
    border: 1px solid #c9d3db;
    padding: 6px;
}

QPlainTextEdit#signallingGroupDetails:focus {
    border-color: #315a70;
}

QLabel#infrastructureGuidance {
    color: #5b6871;
}

QLabel#resultContextText {
    color: #5b6871;
}

QGraphicsView#networkView {
    background: #12191f;
    border: 1px solid #3a4a54;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #e4eaee;
    border: 0;
}

QScrollBar:vertical {
    width: 10px;
    margin: 0;
}

QScrollBar:horizontal {
    height: 10px;
    margin: 0;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #9aa5ab;
    border-radius: 2px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: 0;
}

QStatusBar {
    background: #e3eaee;
    border-top: 1px solid #c9d3db;
    color: #5b6871;
}

QStatusBar QLabel {
    background: transparent;
    padding: 0 4px;
}

QMenu {
    background: #f8fafb;
    border: 1px solid #c9d3db;
}

QMenu::item {
    padding: 5px 24px 5px 8px;
}

QMenu::item:selected {
    background: #d8e1e5;
    color: #24313a;
}
