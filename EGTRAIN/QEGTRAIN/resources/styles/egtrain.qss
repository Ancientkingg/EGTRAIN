QMainWindow, QWidget {
    background: #eef2f5;
    color: #24313a;
}

/* A dialog is one surface: the plain widgets, frames, labels and scroll areas inside it take the colour of the dialog,
   so the body and its scroll viewport show no box of their own. The class selectors (.QWidget, .QFrame) match those
   classes and not their subclasses, so fields, lists, tables and buttons keep their own faces. The colour is opaque,
   because a widget style draws the outline of a check box or a frame from the background colour of its widget. */
QDialog, QDialog .QWidget, QDialog .QFrame, QDialog QLabel, QDialog QScrollArea, QDialog QStackedWidget, QDialog QTabBar,
QDialog QCheckBox, QDialog QRadioButton, QDialog QDialogButtonBox {
    background: #f8fafb;
}

/* A group of settings is a bold title over its fields, without the recessed box that some platforms draw. */
QDialog QGroupBox {
    background: transparent;
    border: 0;
    font-weight: 600;
    margin-top: 1.4em;
}

QDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0;
}

/* The buttons of a dialog footer and of a message box show only their text. Some desktop themes give OK, Cancel and Close
   a dark icon, which would be hard to see on the filled default button. */
QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

QToolBar {
    background: #f8fafb;
    border: 0;
    border-bottom: 1px solid #c9d3db;
    spacing: 4px;
    padding: 1px 8px;
    min-height: 44px;
}

QToolBar::separator {
    background: #c9d3db;
    width: 1px;
    margin: 4px 8px;
}

QToolBar QToolButton#qt_toolbar_ext_button {
    padding: 0;
}

QLabel#speedModeLabel {
    color: #24313a;
    font-weight: 600;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    color: #24313a;
    padding: 3px 6px;
    min-height: 24px;
    max-height: 32px;
}

QToolButton#actionZoomInButton, QToolButton#actionZoomOutButton {
    padding: 3px;
}

QToolBar QLabel, QToolBar QSlider {
    background: transparent;
}

QToolButton:hover, QToolButton:focus {
    background: #e3eaee;
    border-color: #315a70;
}

QToolButton:disabled {
    color: #64717a;
}

/* Toolbar buttons have the corners, border and states of a push button: a white face, the control border, a darker
   border under the pointer, the band face while pressed and a 2 px action border with keyboard focus. The padding gives
   up the extra pixel of the focus border, so the text and the icon do not move. */
QToolBar QToolButton {
    background: #ffffff;
    border-color: #7b8b96;
    border-radius: 6px;
}

QToolBar QToolButton:hover {
    background: #ffffff;
    border-color: #5b6871;
}

QToolBar QToolButton:focus {
    background: #ffffff;
    border: 2px solid #2e7491;
    padding: 2px 5px;
}

QToolButton#actionZoomInButton:focus, QToolButton#actionZoomOutButton:focus {
    padding: 2px;
}

QToolBar QToolButton:pressed {
    background: #e3eaee;
}

QToolBar QToolButton:disabled {
    background: #eceeec;
    border-color: #c9d3db;
}

/* Open Case keeps its own face and weight. */
QToolButton#openCaseButton {
    background: #e3eaee;
    font-weight: 600;
    padding-left: 8px;
    padding-right: 8px;
}

QToolButton#openCaseButton:hover {
    background: #dce6eb;
}

QToolButton#openCaseButton:pressed {
    background: #d8e1e5;
}

QToolButton#openCaseButton:focus {
    padding: 2px 7px;
}

QToolButton:checked, QToolBar QToolButton:checked {
    background: #315a70;
    color: #ffffff;
}

QToolButton#actionFollowButton:checked {
    background: #d3e3ec;
    border-color: #315a70;
    color: #24313a;
}

QToolButton#actionFollowButton:checked:hover {
    background: #bcd2df;
    border-color: #24313a;
}

QToolButton#actionFollowButton:checked:focus {
    border-color: #2e7491;
}

QDockWidget {
    background: #f8fafb;
    color: #24313a;
}

QDockWidget::title {
    background: #e3eaee;
    border-bottom: 1px solid #c9d3db;
    font-weight: 600;
    padding: 6px 8px;
    text-align: left;
}

QLabel#caseNameLabel {
    color: #315a70;
    font-size: 14px;
    font-weight: 600;
    padding: 3px 0 1px;
}

QLabel#caseReadinessLabel {
    color: #5b6871;
    font-size: 11px;
    padding: 0 0 8px;
}

QLabel#caseReadinessLabel[blocking="true"] {
    color: #965c22;
}

QLabel#caseStudyTitleLabel, QLabel#layersTitleLabel {
    color: #5b6871;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
    text-transform: uppercase;
}

QCheckBox {
    spacing: 7px;
    padding: 5px 2px;
}

QListView::indicator, QTableView::indicator, QTreeView::indicator {
    width: 14px;
    height: 14px;
    background: #ffffff;
    border: 1px solid #5b6871;
    border-radius: 2px;
}

QListView::indicator:checked, QTableView::indicator:checked, QTreeView::indicator:checked {
    background: #315a70;
    border-color: #315a70;
    image: url(:/icons/check-mark.svg);
}

QListView::indicator:disabled, QTableView::indicator:disabled, QTreeView::indicator:disabled {
    background: #eceeec;
    border-color: #c9d3db;
}

QListView::indicator:checked:disabled, QTableView::indicator:checked:disabled,
QTreeView::indicator:checked:disabled {
    background: #9aa5ab;
    border-color: #9aa5ab;
}

QCheckBox[secondaryLayerToggle="true"] {
    color: #5b6871;
    margin-left: 16px;
}

QCheckBox:disabled {
    color: #64717a;
}

QCheckBox:focus {
    background: #e3eaee;
    border: 1px solid #2e7491;
    border-radius: 6px;
}

QSlider:focus {
    outline: 1px solid #315a70;
    outline-offset: 1px;
}

/* A push button shows keyboard focus with its border, without a rectangle around its text. */
QPushButton:focus {
    outline: none;
}

/* The map key toggle is a push button with small grey text; checked, it keeps that face. */
QToolButton#mapKeyToggle {
    background: #ffffff;
    border-color: #7b8b96;
    border-radius: 6px;
    color: #5b6871;
    font-size: 11px;
    font-weight: 600;
    padding: 5px 2px;
    text-align: left;
}

QToolButton#mapKeyToggle:hover {
    border-color: #5b6871;
}

QToolButton#mapKeyToggle:focus {
    border: 2px solid #2e7491;
    padding: 4px 1px;
}

QToolButton#mapKeyToggle:pressed {
    background: #e3eaee;
}

QWidget#mapKeyBody QLabel {
    color: #3f4d56;
    font-size: 11px;
}

QTableWidget#runResultsTable:focus {
    border-color: #315a70;
}

/* Push buttons and fields have a white face, a 1 px border in the control colour, #7b8b96, and a 6 px radius, in dialogs
   and in the main window alike. The border has a contrast of 3.5:1 with the white face and 3.4:1 with the surface of a
   dialog. Push buttons, combo boxes and line edits are 28 px tall at a 13 px font. A button in a dialog has 14 px beside
   its text; one in a dock keeps 7 px, so that the editor docks keep their width. */
QPushButton, QToolButton#runResultsViewsButton {
    background: #ffffff;
    border: 1px solid #7b8b96;
    border-radius: 6px;
    color: #24313a;
    padding: 5px 7px;
}

QDialog QPushButton {
    padding: 5px 14px;
}

QComboBox, QLineEdit, QAbstractSpinBox {
    background: #ffffff;
    border: 1px solid #7b8b96;
    border-radius: 6px;
    padding: 4px 7px;
}

QPushButton:hover, QComboBox:hover, QLineEdit:hover, QAbstractSpinBox:hover, QToolButton#runResultsViewsButton:hover {
    border-color: #5b6871;
}

QPushButton:pressed, QToolButton#runResultsViewsButton:pressed {
    background: #e3eaee;
}

/* Keyboard focus is a 2 px border in the action colour, #2e7491, which has a contrast of 5.2:1 with the white face. The
   padding gives up the extra pixel, so the text does not move. */
QPushButton:focus {
    border: 2px solid #2e7491;
    padding: 4px 6px;
}

QDialog QPushButton:focus {
    padding: 4px 13px;
}

QToolButton#runResultsViewsButton:focus {
    border: 2px solid #2e7491;
    padding: 4px 19px 4px 6px;
}

/* The buttons that choose the trains, occurrences or stations of a result window look like the push buttons beside them.
   They keep the padding of a tool button, with 20 px on their right for the arrow, and so their size. */
QDialog TrainFilterButton {
    background: #ffffff;
    border: 1px solid #7b8b96;
    border-radius: 6px;
    padding: 3px 20px 3px 6px;
}

QDialog TrainFilterButton:hover {
    background: #ffffff;
    border-color: #5b6871;
}

QDialog TrainFilterButton:focus {
    background: #ffffff;
    border: 2px solid #2e7491;
    padding: 2px 19px 2px 5px;
}

QDialog TrainFilterButton:pressed {
    background: #e3eaee;
}

QDialog TrainFilterButton:disabled {
    background: #eceeec;
    border-color: #c9d3db;
    color: #64717a;
}

QComboBox:focus, QLineEdit:focus, QAbstractSpinBox:focus {
    border: 2px solid #2e7491;
    padding: 3px 6px;
}

/* The line edit inside a spin box draws no field of its own: the spin box is the field. */
QAbstractSpinBox QLineEdit, QAbstractSpinBox QLineEdit:hover, QAbstractSpinBox QLineEdit:focus,
QAbstractSpinBox QLineEdit:disabled {
    background: transparent;
    border: 0;
    padding: 0;
}

/* Outside a dialog a spin box has 2 px above and below its text and 4 px before it. With Qt 5 it then asks for no more room
   than the Fusion spin box, so the editor docks and their tables keep the size they had with native spin boxes. In a
   dialog it has the padding of the other fields. The arrows take 16 px at the right inside the border. */
QAbstractSpinBox {
    padding: 2px 0 2px 4px;
}

QAbstractSpinBox:focus {
    padding: 1px 0 1px 3px;
}

QDialog QAbstractSpinBox {
    padding: 4px 0 4px 7px;
}

QDialog QAbstractSpinBox:focus {
    padding: 3px 0 3px 6px;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    background: transparent;
    border: 0;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-arrow {
    image: url(:/icons/spin-up-arrow.svg);
}

QAbstractSpinBox::down-arrow {
    image: url(:/icons/drop-down-arrow.svg);
}

QAbstractSpinBox::up-arrow:disabled, QAbstractSpinBox::up-arrow:off {
    image: url(:/icons/spin-up-arrow-disabled.svg);
}

QAbstractSpinBox::down-arrow:disabled, QAbstractSpinBox::down-arrow:off {
    image: url(:/icons/drop-down-arrow-disabled.svg);
}

/* Lists and tables in a dialog are fields: a white face inside the same border and radius. The padding keeps the rows and
   the header inside the rounded corners. */
QDialog QListWidget, QDialog QTableView {
    background: #ffffff;
    border: 1px solid #7b8b96;
    border-radius: 6px;
    padding: 2px;
}

QDialog QListWidget {
    padding: 4px;
}

QDialog QListWidget:focus, QDialog QTableView:focus {
    border: 2px solid #2e7491;
    padding: 1px;
}

QDialog QListWidget:focus {
    padding: 3px;
}

QLabel#dialogContext, QLabel#diagramContext, QLabel#timetableContext,
QLabel#runReviewFactLabel, QLabel[dialogHelp="true"] {
    background: transparent;
    color: #5b6871;
}

QLabel#runReviewFactValue {
    background: transparent;
    font-weight: 600;
}

QLabel[dialogStatus="neutral"], QLabel#runReviewStatus {
    background: #e3eaee;
    border: 1px solid #c9d3db;
    border-radius: 6px;
    color: #3f4d56;
    padding: 8px;
}

QLabel[dialogStatus="warning"], QLabel#runReviewStatus[warning="true"] {
    background: #f5eadc;
    border: 1px solid #d8b98e;
    border-radius: 6px;
    color: #74451c;
    padding: 8px;
}

QLabel[dialogStatus="error"] {
    background: #f7e8e6;
    border: 1px solid #c98f88;
    border-radius: 6px;
    color: #81352d;
    padding: 8px;
}

/* A link of the About dialog reads as a link: underlined text without the face and border of a button. */
QDialog#aboutDialog QPushButton[aboutLink="true"] {
    background: transparent;
    border-color: transparent;
    color: #315a70;
    text-decoration: underline;
    text-align: left;
    padding: 2px 4px;
}

QDialog#aboutDialog QPushButton[aboutLink="true"]:focus {
    border: 2px solid #2e7491;
    padding: 1px 3px;
}

/* A button that opens a menu, such as Other ways to open..., shows the arrow of a drop-down list at its right. */
QPushButton::menu-indicator {
    image: url(:/icons/drop-down-arrow.svg);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 8px;
}

QPushButton::menu-indicator:disabled {
    image: url(:/icons/drop-down-arrow-disabled.svg);
}

/* Each copy of the recovery prompt is a card with the radius of a field and the border of a status label. */
QFrame#recoveryRow {
    border: 1px solid #c9d3db;
    border-radius: 6px;
}

QDialog#caseChooserDialog QListWidget::item:disabled {
    color: #5b6871;
    background: transparent;
}

QDialog#caseChooserDialog QListWidget::item:selected {
    background: #d8e1e5;
    color: #24313a;
}

QLabel#runReviewDetails {
    background: #ffffff;
    border: 1px solid #c9d3db;
    border-radius: 6px;
    padding: 8px;
}

/* The default button of a dialog footer and of a message box is filled with the action colour, #2e7491, on which white
   text has a contrast of 5.2:1. */
QDialog QDialogButtonBox QPushButton:default, QPushButton#runReviewRunButton {
    background: #2e7491;
    border-color: #2e7491;
    color: #ffffff;
}

QPushButton#runReviewRunButton {
    min-width: 110px;
}

QDialog QDialogButtonBox QPushButton:default:hover, QPushButton#runReviewRunButton:hover {
    background: #296882;
    border-color: #296882;
}

QDialog QDialogButtonBox QPushButton:default:pressed, QPushButton#runReviewRunButton:pressed {
    background: #23566c;
    border-color: #23566c;
}

/* The filled default button shows keyboard focus as a 2 px dark border, #0b2430, which has a contrast of 3.1:1 with the
   fill and 15:1 with the dialog. */
QDialog QDialogButtonBox QPushButton:default:focus, QPushButton#runReviewRunButton:focus {
    border: 2px solid #0b2430;
    padding: 4px 13px;
}

QPushButton:disabled,
QComboBox:disabled,
QLineEdit:disabled,
QAbstractSpinBox:disabled,
QToolButton#runResultsViewsButton:disabled {
    background: #eceeec;
    border-color: #c9d3db;
    color: #64717a;
}

QDialog QDialogButtonBox QPushButton:default:disabled, QPushButton#runReviewRunButton:disabled {
    background: #dce3e7;
    border-color: #c9d3db;
    color: #64717a;
}

QTableView {
    background: #ffffff;
    gridline-color: #e3eaee;
}

/* The current cell of a table that Tab reaches has no selection and can be scrolled out of view, so the frame of the table
   shows the focus. */
QTableWidget#runResultsTable {
    border: 1px solid #c9d3db;
}

QTabWidget::pane {
    border: 1px solid #c9d3db;
    background: #f8fafb;
}

QTabBar::tab {
    background: #e3eaee;
    border: 1px solid #c9d3db;
    padding: 4px 12px;
}

QTabBar::tab:selected {
    background: #315a70;
    color: #ffffff;
}

QLineEdit[readOnly="true"] {
    background: #eceeec;
    color: #5b6871;
    border-color: #c9d3db;
}

QLineEdit[readOnly="true"]:focus {
    border: 2px solid #2e7491;
    padding: 3px 6px;
}

QSlider::groove:horizontal {
    height: 6px;
    border-radius: 3px;
    background: #7b8b96;
}

QSlider::sub-page:horizontal {
    border-radius: 3px;
    background: #315a70;
}

QSlider::handle:horizontal {
    width: 12px;
    margin: -5px 0;
    border: 2px solid #ffffff;
    border-radius: 8px;
    background: #315a70;
}

QSlider::handle:horizontal:hover, QSlider::handle:horizontal:pressed {
    background: #26495c;
}

QSlider::handle:horizontal:focus {
    border-color: #24313a;
}

QSlider::sub-page:horizontal:disabled, QSlider::handle:horizontal:disabled {
    background: #9aa5ab;
}

QProgressBar {
    border: 1px solid #c9d3db;
    border-radius: 2px;
    background: #eceeec;
    color: #24313a;
    selection-color: #ffffff;
    text-align: right;
}

QProgressBar::chunk {
    background: #315a70;
}

/* The weight is on the header widget, so code that measures header text with the header font measures it in this weight. */
QHeaderView {
    font-weight: 600;
}

QHeaderView::section, QTableCornerButton::section {
    background: #e3eaee;
    color: #24313a;
    border: 0;
    border-right: 1px solid #c9d3db;
    border-bottom: 1px solid #c9d3db;
    padding: 4px 8px;
}

QAbstractItemView {
    alternate-background-color: #f4f7f9;
}

QPlainTextEdit {
    background: #12191f;
    color: #dde3e5;
}

QPlainTextEdit#signallingGroupDetails {
    background: #ffffff;
    color: #24313a;
    border: 1px solid #c9d3db;
    padding: 6px;
}

QPlainTextEdit#signallingGroupDetails:focus {
    border-color: #315a70;
}

QLabel#infrastructureGuidance {
    color: #5b6871;
}

QLabel#resultContextText {
    color: #5b6871;
}

QGraphicsView#networkView {
    background: #12191f;
    border: 2px solid #3a4a54;
}

QGraphicsView#networkView:focus {
    border-color: #5f8fa8;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #e3eaee;
    border: 0;
}

QScrollBar:vertical {
    width: 10px;
    margin: 0;
}

QScrollBar:horizontal {
    height: 10px;
    margin: 0;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #9aa5ab;
    border-radius: 2px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: 0;
}

QStatusBar {
    background: #e3eaee;
    border-top: 1px solid #c9d3db;
    color: #5b6871;
}

QStatusBar QLabel {
    background: transparent;
    padding: 0 4px;
}

QMenu {
    background: #f8fafb;
    border: 1px solid #c9d3db;
}

QMenu::item {
    padding: 4px 24px 4px 8px;
}

QMenu::item:selected {
    background: #d8e1e5;
    color: #24313a;
}

QMenu::item:disabled {
    color: #64717a;
}

QMenu::item:disabled:selected {
    background: transparent;
    color: #64717a;
}

/* One line in the colour of the menu border; the etched line of the style loses its dark row at fractional scales. */
QMenu::separator {
    height: 1px;
    background: #c9d3db;
    margin: 4px 0;
}

/* Outside a macOS footer, Cancel of Run simulation becomes the default while it has the focus; it keeps the plain face,
   so only the run button is filled. */
QPushButton#runReviewCancelButton:default {
    background: #ffffff;
    border: 2px solid #2e7491;
    color: #24313a;
    padding: 4px 13px;
}

QPushButton#runReviewCancelButton:default:pressed {
    background: #e3eaee;
}

/* A button that opens a menu keeps room on its right for the arrow. Qt 5 matches the popup mode by its number, 2. */
QToolButton[popupMode="2"], QToolButton[popupMode="InstantPopup"], QToolButton#runResultsViewsButton {
    padding-right: 20px;
}

QToolButton[popupMode="2"]::menu-indicator, QToolButton[popupMode="InstantPopup"]::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
}

QLabel#diagramPinLabel {
    background: transparent;
}

/* The drop-down of a combo box draws no frame of its own inside the border, so it takes its arrow from an image. */
QComboBox::drop-down {
    background: transparent;
    border: 0;
    width: 20px;
}

QComboBox::down-arrow {
    image: url(:/icons/drop-down-arrow.svg);
}

QComboBox::down-arrow:disabled {
    image: url(:/icons/drop-down-arrow-disabled.svg);
}
